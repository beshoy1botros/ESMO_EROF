{
  "compilerOptions": {
    "target": "ES2021",                          /* أو أي إصدار JavaScript تفضله */
    "lib": ["DOM", "DOM.Iterable", "ESNext"],    /* المكتبات القياسية */
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,    /* أضف هذا السطر */
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "app"], // أو أي مسار للكود المصدر لديك
  "exclude": ["node_modules"]
}
