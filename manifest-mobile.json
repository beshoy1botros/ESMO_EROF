{
  "name": "Coptic Hymns",
  "short_name": "Coptic Hymns",
  "description": "تطبيق الألحان القبطية الأرثوذكسية — تعليم وتصفح الألحان القبطية بسهولة",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#1e3a8a",
  "background_color": "#060d1f",
  "lang": "ar",
  "dir": "rtl",
  "categories": ["education", "music", "religion"],

  "icons": [
    {
      "src": "/photos/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/photos/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/photos/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "screenshots": [
    {
      "src": "/photos/screenshots/mobile-home.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "الصفحة الرئيسية للتطبيق"
    },
    {
      "src": "/photos/screenshots/mobile-hymn.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "عرض اللحن"
    },
    {
      "src": "/photos/screenshots/tablet-home.png",
      "sizes": "768x1024",
      "type": "image/png",
      "form_factor": "wide",
      "label": "الصفحة الرئيسية على التابلت"
    }
  ],

  "shortcuts": [
    {
      "name": "الألحان اليومية",
      "short_name": "ألحان",
      "description": "الألحان الخاصة باليوم",
      "url": "/daily-hymns",
      "icons": [
        {
          "src": "/photos/icons/shortcuts/daily-hymns.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "البحث",
      "short_name": "بحث",
      "description": "البحث عن الألحان",
      "url": "/search",
      "icons": [
        {
          "src": "/photos/icons/shortcuts/voice-search.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "الإعدادات",
      "short_name": "إعدادات",
      "description": "إعدادات التطبيق",
      "url": "/settings",
      "icons": [
        {
          "src": "/photos/icons/shortcuts/settings.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["audio/*", "image/*", "text/*"] }]
    }
  },

  "file_handlers": [
    {
      "action": "/open",
      "accept": {
        "audio/midi": [".mid", ".midi"],
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg"],
        "text/plain": [".txt"],
        "application/pdf": [".pdf"]
      }
    }
  ],

  "protocol_handlers": [
    { "protocol": "web+esmo", "url": "/handle-protocol?url=%s" }
  ],

  "handle_links": "preferred",

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "edge_side_panel": {
    "preferred_width": 400
  }
}
